{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://rpg-mapping.local/schemas/map_document.schema.json",
	"title": "MapDocument canónico (RPG Mapping)",
	"description": "Forma canónica de core/model/map_document.gd (ADR 019). Solo enteros (nada de float), claves ordenadas al serializar, listas en orden fijo. Sin 'session' es el contenido que cubren content_hash() y las seeds doradas.",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "source", "grid", "next_id", "levels"],
	"properties": {
		"schema_version": { "const": 1 },
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["seed_code", "scale", "gen"],
			"properties": {
				"seed_code": { "type": "string", "description": "Código RPGM1 canónico; vacío si el mapa se creó a mano" },
				"scale": { "enum": ["", "MUN", "REG", "ALD", "EDI", "EST", "MAZ"] },
				"gen": { "type": "integer", "minimum": 0 }
			}
		},
		"grid": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "width", "height"],
			"properties": {
				"kind": { "enum": ["square", "hex_flat", "hex_pointy"] },
				"width": { "type": "integer", "minimum": 1, "maximum": 4096 },
				"height": { "type": "integer", "minimum": 1, "maximum": 4096 }
			}
		},
		"next_id": { "type": "integer", "minimum": 1 },
		"levels": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/level" } },
		"session": {
			"type": "object",
			"additionalProperties": false,
			"required": ["tokens", "fog", "deltas"],
			"properties": {
				"tokens": { "type": "array", "items": { "$ref": "#/$defs/token" } },
				"fog": {
					"type": "array",
					"description": "Una entrada por nivel: observador -> 1 valor por casilla (0/1 = explorada)",
					"items": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cell_layer" } }
				},
				"deltas": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["op", "data"],
						"properties": { "op": { "type": "string" }, "data": { "type": "object" } }
					}
				}
			}
		}
	},
	"$defs": {
		"loot_item": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "qty"],
			"properties": {
				"name": { "type": "string", "minLength": 1, "maxLength": 120 },
				"qty": { "type": "integer", "minimum": 1, "maximum": 999999 },
				"value": { "type": "string", "maxLength": 200 },
				"note": { "type": "string", "maxLength": 200 },
				"kind": { "type": "string", "maxLength": 32, "description": "Tipo de objeto para su icono (data/loot/item_kinds.json; ADR 049)" }
			}
		},
		"cell": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2, "description": "[x, y] = [columna, fila] (offset en hex)" },
		"cell_layer": { "type": "array", "items": { "type": "integer" }, "description": "width*height valores en orden por filas" },
		"level": {
			"type": "object",
			"additionalProperties": false,
			"required": ["terrain", "room_ids", "edges", "rooms", "objects", "stairs", "traps"],
			"properties": {
				"terrain": { "$ref": "#/$defs/cell_layer", "description": "Terrain.* (0 void, 1 floor, 2 wall, 3 rubble, 4 water_shallow, 5 water_deep, 6 pit)" },
				"room_ids": { "$ref": "#/$defs/cell_layer", "description": "Id de sala por casilla; 0 = ninguna" },
				"edges": {
					"type": "array",
					"description": "[x, y, lado, valor] con (x, y, lado) canónico (lado < nº de direcciones con arista / 2) y valor MapEdge (tipo | banderas; tipos 1 muro, 2 puerta, 3 secreta, 4 vano, 5 ventana). Ordenadas por id de arista",
					"items": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4 }
				},
				"rooms": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["id", "kind", "label"],
						"properties": {
							"id": { "type": "integer", "minimum": 1 },
							"kind": { "type": "string", "pattern": "^[a-z0-9_]+$" },
							"label": { "type": "string" }
						}
					}
				},
				"objects": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["id", "catalog_id", "cell", "size", "facing", "cover", "difficult_terrain", "blocks_movement", "blocks_sight", "light_bright_cells", "light_dim_cells", "interaction", "height_mm", "material"],
						"properties": {
							"id": { "type": "integer", "minimum": 1 },
							"catalog_id": { "type": "string" },
							"cell": { "$ref": "#/$defs/cell" },
							"size": { "$ref": "#/$defs/cell" },
							"facing": { "type": "integer", "minimum": 0, "maximum": 5 },
							"cover": { "type": "integer", "minimum": 0, "maximum": 3, "description": "0 ninguna, 1 media, 2 tres cuartos, 3 total" },
							"difficult_terrain": { "type": "boolean" },
							"blocks_movement": { "type": "boolean" },
							"blocks_sight": { "type": "boolean" },
							"light_bright_cells": { "type": "integer", "minimum": 0 },
							"light_dim_cells": { "type": "integer", "minimum": 0 },
							"interaction": { "type": "string" },
							"height_mm": { "type": "integer", "minimum": 0 },
							"material": { "type": "string" },
				"contents": { "type": "array", "items": { "$ref": "#/$defs/loot_item" }, "maxItems": 200, "description": "Contenido (cofres…; ADR 048). Solo si hay algo." },
				"contents_revealed": { "type": "boolean", "description": "El DM lo enseña a los jugadores." }
						}
					}
				},
				"stairs": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["id", "cell", "to_level", "to_cell", "facing"],
						"properties": {
							"id": { "type": "integer", "minimum": 1 },
							"cell": { "$ref": "#/$defs/cell" },
							"to_level": { "type": "integer", "description": "Nivel de destino. Fuera de [0, niveles) = sale de este mapa: en una estancia de edificio (EST G2, ADR 029) es relativo al nivel del edificio (-1 baja, +1 sube)." },
							"to_cell": { "$ref": "#/$defs/cell" },
							"facing": { "type": "integer", "minimum": 0, "maximum": 5 }
						}
					}
				},
				"traps": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["id", "cell", "trap_id", "hidden", "armed"],
						"properties": {
							"id": { "type": "integer", "minimum": 1 },
							"cell": { "$ref": "#/$defs/cell" },
							"trap_id": { "type": "string" },
							"hidden": { "type": "boolean" },
							"armed": { "type": "boolean" }
						}
					}
				},
				"biome": { "$ref": "#/$defs/cell_layer", "description": "Opcional (F6, MUN/REG): Biome.* por casilla (0 ocean … 17 mountain). Se omite si está vacía" },
				"elevation": { "$ref": "#/$defs/cell_layer", "description": "Opcional (F6): elevación cuantizada 0..255; < 64 agua (profundidad (64−e)·100 m), >= 64 tierra (altitud (e−64)·40 m). GeoLayers" },
				"features": { "$ref": "#/$defs/cell_layer", "description": "Opcional (F6): bits 0-1 clase de río, bit 2 camino, bit 3 costa, bits 4-7 dirección de la corriente + 1 (índice de dirección de la rejilla). GeoLayers" },
				"children": {
					"type": "array",
					"minItems": 1,
					"description": "Opcional (F3, ADR 027): mapas hijos anclados en el nivel (edificios de un asentamiento ALD; asentamientos y puntos de interés de MUN/REG, cuya escala es distinta: solo valen rect, entrance y entrance − offset), ordenados por id. Se omite si no hay ninguno, así los documentos sin hijos conservan su hash. La casilla c del nivel child_level del hijo es la casilla c + offset de este nivel",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["id", "kind", "seed_code", "room_id", "offset", "child_level", "rect", "entrance"],
						"properties": {
							"id": { "type": "integer", "minimum": 1 },
							"kind": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "Tipo del hijo (edificio: building_type de EDI)" },
							"seed_code": { "type": "string", "description": "Código RPGM1 canónico que regenera el hijo" },
							"room_id": { "type": "integer", "minimum": 0, "description": "Zona de este nivel que ocupa la huella (en MUN/REG, el reino de la casilla; 0 = ninguno)" },
							"offset": { "$ref": "#/$defs/cell" },
							"child_level": { "type": "integer", "minimum": 0 },
							"rect": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4, "description": "Huella [x, y, ancho, alto] en casillas de este nivel" },
							"entrance": { "$ref": "#/$defs/cell" },
							"label": { "type": "string", "description": "Opcional (F6): nombre propio de un asentamiento de mundo o región; se omite si está vacío" }
						}
					}
				}
			}
		},
		"token": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "level", "cell", "size_id", "side", "character_ref", "hidden"],
			"properties": {
				"id": { "type": "integer", "minimum": 1 },
				"name": { "type": "string" },
				"level": { "type": "integer", "minimum": 0 },
				"cell": { "$ref": "#/$defs/cell" },
				"size_id": { "type": "string" },
				"side": { "enum": ["player", "ally", "neutral", "enemy"] },
				"character_ref": { "type": "string", "description": "Dueño en la partida en red (player:<id>) o referencia libre." },
				"hidden": { "type": "boolean" },
				"sheet": { "$ref": "character.schema.json", "description": "Personaje de la ficha (opcional, F5)." },
				"loot": { "type": "array", "items": { "$ref": "#/$defs/loot_item" }, "maxItems": 200, "description": "Botín de la ficha (ADR 048). Solo si hay algo." },
				"loot_revealed": { "type": "boolean", "description": "El DM lo enseña a los jugadores." }
			}
		}
	}
}
