{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://rpg-mapping.local/schemas/system_profile.schema.json",
	"title": "Perfil de sistema de juego (RPG Mapping)",
	"description": "Reglas como datos (PROYECTO.md §8). Todas las cantidades son enteras: el determinismo prohíbe floats.",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "id", "seed_code", "name_key", "content", "grid", "movement", "sizes_occupy_cells", "sizes", "range_bands", "senses", "area_templates"],
	"properties": {
		"schema_version": { "const": 1 },
		"id": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "Igual al nombre del fichero sin .json" },
		"seed_code": { "type": "string", "pattern": "^[A-Z0-9]{3,4}$", "description": "Campo SIS del código RPGM1; único entre perfiles" },
		"name_key": { "type": "string", "description": "Clave de i18n del nombre visible" },
		"content": {
			"type": "object",
			"additionalProperties": false,
			"required": ["source", "license", "attribution", "attribution_verified"],
			"properties": {
				"source": { "type": "string" },
				"license": { "enum": ["CC-BY-4.0", "ORC"] },
				"attribution": { "type": "string" },
				"attribution_verified": { "type": "boolean", "description": "false = no publicar sin revisar el texto de atribución" }
			}
		},
		"grid": {
			"type": "object",
			"additionalProperties": false,
			"required": ["cell_ft", "measure"],
			"properties": {
				"cell_ft": { "type": "integer", "minimum": 1 },
				"measure": { "enum": ["grid", "bands"] }
			}
		},
		"movement": {
			"type": "object",
			"additionalProperties": false,
			"required": ["default_speed_ft", "diagonal_ft", "diagonal_variants", "difficult_terrain", "modes"],
			"properties": {
				"default_speed_ft": { "type": "integer", "minimum": 0 },
				"diagonal_ft": { "$ref": "#/$defs/diagonal_pattern" },
				"diagonal_variants": {
					"type": "object",
					"additionalProperties": { "$ref": "#/$defs/diagonal_pattern" }
				},
				"difficult_terrain": {
					"type": "object",
					"additionalProperties": false,
					"required": ["multiplier_pct", "extra_ft_per_cell", "visual_only"],
					"properties": {
						"multiplier_pct": { "type": "integer", "minimum": 100 },
						"extra_ft_per_cell": { "type": "integer", "minimum": 0 },
						"visual_only": { "type": "boolean" }
					}
				},
				"modes": { "type": "array", "items": { "enum": ["walk", "fly", "swim", "climb", "burrow"] }, "uniqueItems": true }
			}
		},
		"sizes_occupy_cells": { "type": "boolean" },
		"sizes": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "space_ft_x10"],
				"properties": {
					"id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
					"space_ft_x10": { "type": "integer", "minimum": 1, "description": "Lado ocupado en décimas de pie (2,5 ft = 25)" }
				}
			}
		},
		"range_bands": {
			"type": "array",
			"description": "Orden creciente; max_cells = -1 solo en la última (sin límite)",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "max_cells"],
				"properties": {
					"id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
					"max_cells": { "type": "integer", "minimum": -1 }
				}
			}
		},
		"senses": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "uniqueItems": true },
		"area_templates": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "uniqueItems": true }
	},
	"$defs": {
		"diagonal_pattern": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "integer", "minimum": 1 },
			"description": "Coste en pies de las diagonales sucesivas; se repite cíclicamente"
		}
	}
}
