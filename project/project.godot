; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RPG Mapping"
config/description="Generador y visor de mapas de rol deterministas (2D, 3D y primera persona)."
config/version="0.0.1"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/main_scene="res://ui/main.tscn"
run/main_scene.web_tests="res://tests/web/web_runner.tscn"

[debug]

gdscript/warnings/exclude_addons=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2
gdscript/warnings/return_value_discarded=0
gdscript/warnings/integer_division=0

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.es.translation", "res://i18n/strings.en.translation")
locale/fallback="es"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
